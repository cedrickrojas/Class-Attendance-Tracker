{
  "name": "class-trackerbonia",
  "version": "1.0.0",
  "private": true,
  "description": "Class Trackerbonia - Smart Class Attendance Tracker (Ionic + Vue 3 + Firebase)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:quick": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "create-admin": "node scripts/create-admin.mjs",
    "security-check": "node scripts/security-check.mjs",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@ionic/vue": "^8.4.0",
    "@ionic/vue-router": "^8.4.0",
    "firebase": "^11.1.0",
    "ionicons": "^7.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "firebase-tools": "^15.30.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
